# ==============================================================================
# Git 属性配置
#
# 目标：文本文件统一换行与编码声明；二进制资源交给 Git LFS 管理，
#       避免大图进入普通对象库，也避免在 diff/合并时被当成文本处理。
# LFS 模式：png / ico / jpg / jpeg / gif / webp
# 注意：SVG 是文本（可 diff、可 review），不要放进 LFS。

# 默认：文本自动规范化换行；工作区检出为 CRLF，仓库内存 LF
* text=auto eol=crlf
# 脚本必须保留 LF，否则在 Linux/macOS 上无法执行
*.sh    text eol=lf
*.bash  text eol=lf
# 源码与文档：显式声明文本类型与编码
*.cpp           text charset=utf-8
*.h             text charset=utf-8
*.hpp           text charset=utf-8
*.in            text charset=utf-8
*.md            text charset=utf-8
*.txt           text charset=utf-8
*.qml           text charset=utf-8
*.json          text charset=utf-8
*.yml           text charset=utf-8
*.yaml          text charset=utf-8
CMakeLists.txt  text charset=utf-8
*.cmake         text charset=utf-8
*.svg           text charset=utf-8
# 图像与图标走 Git LFS
*.png   filter=lfs diff=lfs merge=lfs -text
*.ico   filter=lfs diff=lfs merge=lfs -text
*.jpg   filter=lfs diff=lfs merge=lfs -text
*.jpeg  filter=lfs diff=lfs merge=lfs -text
*.gif   filter=lfs diff=lfs merge=lfs -text
*.webp  filter=lfs diff=lfs merge=lfs -text
# 其它二进制格式（不进 LFS，但按二进制处理，避免行尾/合并破坏）
*.zip   binary
*.pdf   binary
*.exe   binary
*.dll   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.png filter=lfs diff=lfs merge=lfs -text
*.ico filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.gif filter=lfs diff=lfs merge=lfs -text
*.webp filter=lfs diff=lfs merge=lfs -text
