{
    "id": "gsi",
    "name": "反恐精英 2",
    "version": "0.7.0",
    "author": "CrimsonSeraph",
    "description": "通过游戏状态集成读取 CS2 对局数据，输出血量、护甲、金钱、回合、炸弹与比赛阶段等数值",
    "banner": "banner.png",
    "tags": ["游戏遥测", "GSI"],
    "events": [
        {
            "id": "health_drop",
            "label": "血量下降",
            "trigger": { "value": "health", "compare": "decrease", "amount": 20 },
            "options": [
                { "id": "light", "label": "轻伤" },
                { "id": "heavy", "label": "重伤" }
            ]
        },
        {
            "id": "health_critical",
            "label": "血量濒死",
            "trigger": { "value": "health", "compare": "cross_below", "amount": 25 },
            "options": [
                { "id": "near_death", "label": "濒死" }
            ]
        },
        {
            "id": "armor_break",
            "label": "护甲耗尽",
            "trigger": { "value": "armor", "compare": "cross_below", "amount": 1 },
            "options": [
                { "id": "cracked", "label": "护甲击破" }
            ]
        },
        {
            "id": "helmet_pickup",
            "label": "拾取头盔",
